<Project>

  <!-- Explicit SDK imports so the VS 2022 VSSDK targets can be imported after Sdk.targets (see the end). -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>VsConan</RootNamespace>
    <UseWPF>true</UseWPF>

    <!-- Lets Microsoft.VSSDK.BuildTools wire up VSIX packaging for an SDK-style project. -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>

  <!--
    F5 deploys the extension into the experimental instance ("Exp" root suffix) and launches it.
    VS 2026: its VSIX project system (DebuggerFlavor=VsixDebugger, set by the 18.x tools) deploys and
      launches, provided Deploy is ticked for this project in Configuration Manager (VsConan.sln).
    VS 2022: the build deploys (below) and Properties/launchSettings.json launches.
  -->
  <PropertyGroup Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(Configuration)' == 'Debug' and '$(VisualStudioVersion)' == '17.0'">
    <DeployExtension>true</DeployExtension>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Command-line builds only package the VSIX (the 17.x tools would otherwise deploy by default). -->
    <DeployExtension Condition="'$(DeployExtension)' == ''">false</DeployExtension>
  </PropertyGroup>

  <ItemGroup>
    <!-- 17.0 reference assemblies so the extension loads in every VS 2022 and VS 2026 release. -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.32112.339" ExcludeAssets="runtime" />
    <!-- The VSIX deploy tasks load the building VS's own assemblies, so VS 2022 needs the 17.x tools. -->
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" Condition="'$(VisualStudioVersion)' == '17.0'" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" Condition="'$(VisualStudioVersion)' != '17.0'" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Design" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VsConan.Core\VsConan.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <VSCTCompile Include="VsConanPackage.vsct" ResourceName="Menus.ctmenu" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!--
    The 18.x tools import their targets via VSSDKBuildToolsAutoSetup; the 17.x tools need it done here,
    after Sdk.targets, which would otherwise reset the PrepareForRunDependsOn hooks they add.
  -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets"
          Condition="'$(VisualStudioVersion)' == '17.0' and Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

</Project>
