<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidVsConanPackage">
    <Menus>
      <Menu guid="guidVsConanCmdSet" id="ConanMenu" priority="0x0100" type="Menu">
        <Parent guid="guidVsConanCmdSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>Conan</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidVsConanCmdSet" id="ToolsMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <Group guid="guidVsConanCmdSet" id="ConanMenuGroup" priority="0x0100">
        <Parent guid="guidVsConanCmdSet" id="ConanMenu" />
      </Group>
    </Groups>

    <!--
      Each command has a canonical name, so automation can run it with arguments:
        DTE.ExecuteCommand("Conan.InstallDependencies", "/id:42")
      With arguments the commands run without UI and report to .vs/VsConan/command-result.json
      (see "Automation" in README.md). Without, they behave as the menu items.
      They're hidden, and disabled for automation, unless the open folder is a Conan CMake
      project (see VsConanPackage.AddCommand).
    -->
    <Buttons>
      <Button guid="guidVsConanCmdSet" id="InstallDependenciesCommandId" priority="0x0100" type="Button">
        <Parent guid="guidVsConanCmdSet" id="ConanMenuGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>AllowParams</CommandFlag>
        <Strings>
          <ButtonText>Install Dependencies</ButtonText>
          <CanonicalName>.Conan.InstallDependencies</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidVsConanCmdSet" id="SelectProfilesCommandId" priority="0x0200" type="Button">
        <Parent guid="guidVsConanCmdSet" id="ConanMenuGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>AllowParams</CommandFlag>
        <Strings>
          <ButtonText>Select Profiles...</ButtonText>
          <CanonicalName>.Conan.SelectProfiles</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidVsConanCmdSet" id="ShowStatusCommandId" priority="0x0300" type="Button">
        <Parent guid="guidVsConanCmdSet" id="ConanMenuGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>AllowParams</CommandFlag>
        <Strings>
          <ButtonText>Show Status</ButtonText>
          <CanonicalName>.Conan.ShowStatus</CanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidVsConanPackage" value="{b0936d89-2ca9-4bff-b436-e9b263f971a2}" />
    <GuidSymbol name="guidVsConanCmdSet" value="{7567d0e1-08e2-4f9e-b037-d72b4de5e320}">
      <IDSymbol name="ConanMenu" value="0x1000" />
      <IDSymbol name="ToolsMenuGroup" value="0x1020" />
      <IDSymbol name="ConanMenuGroup" value="0x1021" />
      <IDSymbol name="InstallDependenciesCommandId" value="0x0100" />
      <IDSymbol name="SelectProfilesCommandId" value="0x0101" />
      <IDSymbol name="ShowStatusCommandId" value="0x0102" />
    </GuidSymbol>
  </Symbols>

</CommandTable>
